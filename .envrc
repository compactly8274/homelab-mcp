# .envrc — for `direnv` (https://direnv.net/). Pin the project venv
# location so `uv sync` puts it in .venv/ and not the default venv/.
# If you don't use direnv, just set this env var before `uv sync`:
#   export UV_PROJECT_ENVIRONMENT=.venv
#
# uv < 0.5 honors UV_PROJECT_ENVIRONMENT. uv >= 0.5 also requires
# --active or the absence of a VIRTUAL_ENV mismatch; the venv will
# still live in venv/ by default. The .envrc auto-activates .venv/
# so subsequent `uv run ...` invocations target the right env.

export UV_PROJECT_ENVIRONMENT=.venv
# Clean up the old venv/ if it exists from a previous default install
[ -d venv ] && [ ! -f venv/.marker ] && rm -rf venv 2>/dev/null || true

# Auto-activate the venv on cd.
[ -f .venv/bin/activate ] && source .venv/bin/activate
