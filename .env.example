# homelab-mcp — required environment variables
#
# Copy this file to `.env` and fill in. The MCP entry point
# (python -m homelab_mcp) and the auto-apply cron entry point
# (python -m homelab_mcp.auto_apply_main) both read these.
#
# You can also pass any of these as command-line env vars; the
# .env file is just a convenience for local development.

# ---- Required: at least one host ----------------------------------------
# A JSON list of host aliases. Each alias must have a corresponding
# entry in HOMELAB_MCP_SSH_CONFIG (the alias is the SSH Host alias,
# which the RemoteSSH backend uses to connect).
HOMELAB_MCP_HOSTS=["unraid"]

# ---- Server -------------------------------------------------------------
# TCP port for the MCP server's SSE transport. Exposed as
# /sse in the FastMCP Starlette app.
HOMELAB_MCP_PORT=18790

# Local state directory. SQLite DB (state.db) and the
# last_scan.txt timestamp live here. Must be writable by the
# running user. Default: $XDG_STATE_HOME/homelab-mcp or
# ~/.local/share/homelab-mcp.
HOMELAB_MCP_STATE_DIR=/data

# Path to the SSH config the RemoteSSH backend uses. When
# deployed via Docker, this should be /root/.ssh/config with
# the user bind-mounting their own config in.
HOMELAB_MCP_SSH_CONFIG=/root/.ssh/config

# ---- Visibility-cron (image-drift scanner) -----------------------------
# Whether to start the scanner at server boot. Set to "false" if
# you run a separate cron container.
HOMELAB_MCP_POLL_ENABLED=true

# Seconds between scans. Default 6h. The cron is restart-aware
# (waits interval - elapsed since the last successful scan before
# running).
HOMELAB_MCP_POLL_INTERVAL=21600

# ---- ntfy notifier (BREAKING alerts) -----------------------------------
# ntfy base URL. The full URL is <base>/<topic>.
HOMELAB_MCP_NTFY_URL=https://ntfy.sh/

# ntfy topic. **Required for BREAKING alerts**. Create the topic
# once (e.g. ntfy.sh/<your-topic>) before enabling.
HOMELAB_MCP_NTFY_TOPIC=

# Default priority. ntfy uses these levels: min, low, default, high,
# urgent. BREAKING alerts always use 'high' regardless of this.
HOMELAB_MCP_NTFY_PRIORITY=default

# ---- LLM risk classifier -----------------------------------------------
# OpenAI-compatible chat-completions URL. Defaults to local Ollama.
# Other compatible servers: vLLM, llama.cpp with a shim, MiniMax M3.
HOMELAB_MCP_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions

# Bearer token. Local Ollama doesn't need one; OpenAI/Anthropic do.
# If your local proxy doesn't enforce auth, leave empty.
HOMELAB_MCP_LLM_API_KEY=

# Model name. Examples: llama3.1:8b, qwen2.5:14b, claude-3-5-sonnet-latest.
HOMELAB_MCP_LLM_MODEL=llama3.1:8b

# Timeout in seconds for the classifier round-trip.
HOMELAB_MCP_LLM_TIMEOUT=30

# ---- Auto-apply policy --------------------------------------------------
# One of:
#   safe-and-caution   (default) apply SAFE + CAUTION; notify on BREAKING
#   safe-only          apply SAFE only; notify on CAUTION + BREAKING
# Setting to anything else is rejected at startup.
HOMELAB_MCP_AUTO_APPLY_POLICY=safe-and-caution

# Which host alias is the local docker socket. When the daemon is
# deployed to Unraid, leave this at 'unraid' (default). When
# deployed to TrueNAS (the 'main hub' config), set to 'truenas' so
# the daemon uses LocalDocker for TrueNAS and RemoteSSH for Unraid
# + any other downstream hosts.
HOMELAB_MCP_LOCAL_HOST_ALIAS=unraid

# Dockge stack root. Used when a stack has the com.dockge.owner or
# auto-update.dockge=true label; the orchestrator will run
#   cd <root>/<project> && docker compose pull/up -d
# Default: TrueNAS standard path.
HOMELAB_MCP_DOCKGE_STACKS_ROOT=/mnt/Data/appdata/dockge/stacks

# ---- Auto-apply cron one-shot -------------------------------------------
# When the cron entry point (python -m homelab_mcp.auto_apply_main)
# is run as a one-shot, set this to "1" to skip the actual apply
# step (still classifies, still notifies). The CLI also has a
# --dry-run flag; this env var is a shortcut for cron jobs.
HOMELAB_MCP_AUTO_APPLY_DRY_RUN=

# Per-row timeout (seconds). If one pending-update row takes longer
# than this, the cron moves on to the next row and logs a timeout.
HOMELAB_MCP_AUTO_APPLY_PER_ROW_TIMEOUT=120
