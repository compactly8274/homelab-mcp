# homelab-mcp Dockge stack env. Copy to .env and fill in.
#
# Required:
#   IMAGE              the GHCR image to run, e.g. ghcr.io/<owner>/homelab-mcp:latest
#   HOMELAB_MCP_HOSTS  JSON list of host aliases, e.g. ["truenas","unraid","qnap"]
#
# Local-host alias:
#   HOMELAB_MCP_LOCAL_HOST_ALIAS=truenas   (this is TrueNAS, the daemon host)

# ---- image ---------------------------------------------------------------
IMAGE=ghcr.io/your-org/homelab-mcp:latest

# ---- hosts ---------------------------------------------------------------
HOMELAB_MCP_HOSTS=["truenas","unraid"]
HOMELAB_MCP_LOCAL_HOST_ALIAS=truenas

# ---- ntfy (required for BREAKING alerts) --------------------------------
HOMELAB_MCP_NTFY_URL=https://ntfy.sh/
HOMELAB_MCP_NTFY_TOPIC=homelab-mcp-alerts
HOMELAB_MCP_NTFY_PRIORITY=default

# ---- LLM (required for risk classification) -----------------------------
# Local Ollama on TrueNAS:
HOMELAB_MCP_LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
HOMELAB_MCP_LLM_API_KEY=
HOMELAB_MCP_LLM_MODEL=llama3.1:8b
HOMELAB_MCP_LLM_TIMEOUT=30

# ---- policy --------------------------------------------------------------
HOMELAB_MCP_AUTO_APPLY_POLICY=safe-and-caution

# ---- Dockge stacks --------------------------------------------------------
HOMELAB_MCP_DOCKGE_STACKS_ROOT=/mnt/Data/appdata/dockge/stacks

# ---- visibility cron ------------------------------------------------------
HOMELAB_MCP_POLL_ENABLED=true
HOMELAB_MCP_POLL_INTERVAL=21600
